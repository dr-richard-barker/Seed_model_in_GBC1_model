\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Flight sowing layout, porous foam water content, and 3D CFD airflow microclimate of the LEAF GBC1 growth chamber.} \textbf  {a}, CAD schematic of the GBC1 body showing the three compartments separated by solid baffles at $Z = \pm 8.5\ \mathrm  {mm}$ and the nominal 164-seed sowing layout ($8 \times 4$ \textit  {B. rapa} in Chamber 1, $10 \times 10$ \textit  {A. thaliana} in Chamber 2, $8 \times 4$ \textit  {B. rapa} in Chamber 3) on the 35~$\mu $m Nytex screen ($Y = 14.77\ \mathrm  {mm}$). \textbf  {b}, Van Genuchten volumetric water content $\theta _w(x,z)$ across the phenolic foam substrate under lunar gravity ($g = 0.166g$). \textbf  {c}, 3D CFD air velocity magnitude field $u(x,y,z)$ in Push airflow mode ($Q = 25\ \mathrm  {mL\,min^{-1}}$), showing accelerated jet convergence into Chamber 2. \textbf  {d}, Spatial distribution of boundary-layer conductance $g_{\mathrm  {bl}}$ across all 164 seed locations.}}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:sowing}{{1}{2}{\textbf {Flight sowing layout, porous foam water content, and 3D CFD airflow microclimate of the LEAF GBC1 growth chamber.} \textbf {a}, CAD schematic of the GBC1 body showing the three compartments separated by solid baffles at $Z = \pm 8.5\ \mathrm {mm}$ and the nominal 164-seed sowing layout ($8 \times 4$ \textit {B. rapa} in Chamber 1, $10 \times 10$ \textit {A. thaliana} in Chamber 2, $8 \times 4$ \textit {B. rapa} in Chamber 3) on the 35~$\mu $m Nytex screen ($Y = 14.77\ \mathrm {mm}$). \textbf {b}, Van Genuchten volumetric water content $\theta _w(x,z)$ across the phenolic foam substrate under lunar gravity ($g = 0.166g$). \textbf {c}, 3D CFD air velocity magnitude field $u(x,y,z)$ in Push airflow mode ($Q = 25\ \mathrm {mL\,min^{-1}}$), showing accelerated jet convergence into Chamber 2. \textbf {d}, Spatial distribution of boundary-layer conductance $g_{\mathrm {bl}}$ across all 164 seed locations}{figure.caption.1}{}}
\newlabel{sec:res_pheno}{{}{2}{}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Predicted 3D cellular seedling phenotypic variation across spaceflight environmental, atmospheric, radiation, and hardware vectors.} \textbf  {a}, 3D cellular seed anatomy and 35~$\mu $m Nytex screen barrier deflection ($Y = 14.77\ \mathrm  {mm}$), demonstrating 100\% exclusion from polyurethane foam pores and tangential radicle elongation with end-of-mission fixative perfusion safety ($\Delta P = 1.75\ \mathrm  {kPa} \ll 8.04\ \mathrm  {kPa}$ bubble point). \textbf  {b}, Gravitational regimes: statolith amyloplast sedimentation driving downward gravitropic descent under terrestrial 1.0g, attenuated sedimentation and wider descent dispersion under lunar 0.166g, and wandering radicles governed by autotropism and hydrotropism in 0g microgravity. \textbf  {c}, Atmospheric pressure and gas chemistry: normoxic development (21~$\mathrm  {kPa}\ \mathrm  {O}_2$) versus stunting under hypoxia ($< 5\ \mathrm  {kPa}\ \mathrm  {O}_2$) and classic ethylene triple response ($> 50\ \mathrm  {ppb}\ \ce {C2H4}$) characterized by radial hypocotyl swelling, shortened axial extension, and exaggerated apical hook curvature. \textbf  {d}, Convective airflow: thin boundary layer ($\delta _{\mathrm  {bl}} \approx 0.8\ \mathrm  {mm}$, $g_{\mathrm  {bl}} = 13.4\ \mathrm  {mm\,s^{-1}}$) in active sweep mode ($Q = 25\ \mathrm  {mL\,min^{-1}}$) versus stagnant thermal and ethylene entrapment ($Q = 0$, $g_{\mathrm  {bl}} < 3\ \mathrm  {mm\,s^{-1}}$). \textbf  {e}, Cosmic radiation: ionizing high-LET heavy ions (e.g., $^{56}\mathrm  {Fe}$) and solar particle events (SPE) inducing DNA double-strand breaks, G2/M cell-cycle checkpoint arrest in root apical meristems, and organ dwarfism. \textbf  {f}, Canopy light quality and neighbor crowding: solitary open stand (high red:far-red ratio, compact rosette) versus dense lawn shade avoidance (low red:far-red ratio, SAS hypocotyl elongation, and 3D phototropic lean away from neighbor crowns). \textbf  {g}, Quantitative multi-vector phenotypic response comparison matrix at 120~h normalized against terrestrial 1g control.}}{3}{figure.caption.2}\protected@file@percent }
\newlabel{fig:phenotypes}{{2}{3}{\textbf {Predicted 3D cellular seedling phenotypic variation across spaceflight environmental, atmospheric, radiation, and hardware vectors.} \textbf {a}, 3D cellular seed anatomy and 35~$\mu $m Nytex screen barrier deflection ($Y = 14.77\ \mathrm {mm}$), demonstrating 100\% exclusion from polyurethane foam pores and tangential radicle elongation with end-of-mission fixative perfusion safety ($\Delta P = 1.75\ \mathrm {kPa} \ll 8.04\ \mathrm {kPa}$ bubble point). \textbf {b}, Gravitational regimes: statolith amyloplast sedimentation driving downward gravitropic descent under terrestrial 1.0g, attenuated sedimentation and wider descent dispersion under lunar 0.166g, and wandering radicles governed by autotropism and hydrotropism in 0g microgravity. \textbf {c}, Atmospheric pressure and gas chemistry: normoxic development (21~$\mathrm {kPa}\ \mathrm {O}_2$) versus stunting under hypoxia ($< 5\ \mathrm {kPa}\ \mathrm {O}_2$) and classic ethylene triple response ($> 50\ \mathrm {ppb}\ \ce {C2H4}$) characterized by radial hypocotyl swelling, shortened axial extension, and exaggerated apical hook curvature. \textbf {d}, Convective airflow: thin boundary layer ($\delta _{\mathrm {bl}} \approx 0.8\ \mathrm {mm}$, $g_{\mathrm {bl}} = 13.4\ \mathrm {mm\,s^{-1}}$) in active sweep mode ($Q = 25\ \mathrm {mL\,min^{-1}}$) versus stagnant thermal and ethylene entrapment ($Q = 0$, $g_{\mathrm {bl}} < 3\ \mathrm {mm\,s^{-1}}$). \textbf {e}, Cosmic radiation: ionizing high-LET heavy ions (e.g., $^{56}\mathrm {Fe}$) and solar particle events (SPE) inducing DNA double-strand breaks, G2/M cell-cycle checkpoint arrest in root apical meristems, and organ dwarfism. \textbf {f}, Canopy light quality and neighbor crowding: solitary open stand (high red:far-red ratio, compact rosette) versus dense lawn shade avoidance (low red:far-red ratio, SAS hypocotyl elongation, and 3D phototropic lean away from neighbor crowns). \textbf {g}, Quantitative multi-vector phenotypic response comparison matrix at 120~h normalized against terrestrial 1g control}{figure.caption.2}{}}
