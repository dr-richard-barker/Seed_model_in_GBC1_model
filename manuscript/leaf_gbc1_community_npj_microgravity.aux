\newlabel{sec:res_chamber}{{}{4}{}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {3D cellular developmental progression and community germination kinetics across species and environments.} \textbf  {a--e}, Mid-plane 3D cellular digital twin developmental progression simulated with \textit  {deepspace-seed-twin} (\url  {https://github.com/dr-richard-barker/deepspace-seed-twin}): \textbf  {a}, 0~h dry dormant seed; \textbf  {b}, 24~h imbibition and outer testa rupture; \textbf  {c}, 32~h micropylar endosperm rupture matching $t_{50} = 32.5\ \mathrm  {h}$ in Chamber 2; \textbf  {d}, 72~h emergence contacting the 35~$\mu $m Nytex screen and initiating tangential gliding; \textbf  {e}, 120~h mature seedling with expanded cotyledons and tissue fate mapping (epidermis, cortex, endodermis, stele, quiescent center, columella, and endosperm). \textbf  {f}, Compartment germination kinetics $G(t)$ ($t_{50} = 20.2\ \mathrm  {h}$ in \textit  {B. rapa} vs. $32.5\ \mathrm  {h}$ in \textit  {A. thaliana}). \textbf  {g}, Single-seed hydrotime base water-potential spread ($\Delta \psi _b$ vs. rupture time) demonstrating 100\% concordance (Gate 4). \textbf  {h}, Hypocotyl elongation trajectories across gravity levels (1.0g Earth vs. 0.166g Moon vs. 0.0g ISS). \textbf  {i}, Tangential root crawling kinematics along the 35~$\mu $m Nytex screen (Gate 3).}}{5}{figure.caption.3}\protected@file@percent }
\newlabel{fig:kinetics}{{3}{5}{\textbf {3D cellular developmental progression and community germination kinetics across species and environments.} \textbf {a--e}, Mid-plane 3D cellular digital twin developmental progression simulated with \textit {deepspace-seed-twin} (\url {https://github.com/dr-richard-barker/deepspace-seed-twin}): \textbf {a}, 0~h dry dormant seed; \textbf {b}, 24~h imbibition and outer testa rupture; \textbf {c}, 32~h micropylar endosperm rupture matching $t_{50} = 32.5\ \mathrm {h}$ in Chamber 2; \textbf {d}, 72~h emergence contacting the 35~$\mu $m Nytex screen and initiating tangential gliding; \textbf {e}, 120~h mature seedling with expanded cotyledons and tissue fate mapping (epidermis, cortex, endodermis, stele, quiescent center, columella, and endosperm). \textbf {f}, Compartment germination kinetics $G(t)$ ($t_{50} = 20.2\ \mathrm {h}$ in \textit {B. rapa} vs. $32.5\ \mathrm {h}$ in \textit {A. thaliana}). \textbf {g}, Single-seed hydrotime base water-potential spread ($\Delta \psi _b$ vs. rupture time) demonstrating 100\% concordance (Gate 4). \textbf {h}, Hypocotyl elongation trajectories across gravity levels (1.0g Earth vs. 0.166g Moon vs. 0.0g ISS). \textbf {i}, Tangential root crawling kinematics along the 35~$\mu $m Nytex screen (Gate 3)}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Sowing density sweep ($0.25\times $ to $2.0\times $ nominal flight density).} \textbf  {a}, Linear scaling of canopy $LAI$ across density multipliers. \textbf  {b}, Monotonic decrease of foliar light transmittance $f_{\mathrm  {light}}$ via Beer--Lambert extinction. \textbf  {c}, Shade-avoidance syndrome (SAS) hypocotyl elongation boost. \textbf  {d}, Lateral shoot lean angle ($\theta _{\mathrm  {lean}}$) response to neighbor crowding.}}{6}{figure.caption.4}\protected@file@percent }
\newlabel{fig:density}{{4}{6}{\textbf {Sowing density sweep ($0.25\times $ to $2.0\times $ nominal flight density).} \textbf {a}, Linear scaling of canopy $LAI$ across density multipliers. \textbf {b}, Monotonic decrease of foliar light transmittance $f_{\mathrm {light}}$ via Beer--Lambert extinction. \textbf {c}, Shade-avoidance syndrome (SAS) hypocotyl elongation boost. \textbf {d}, Lateral shoot lean angle ($\theta _{\mathrm {lean}}$) response to neighbor crowding}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Chamber headspace gas exchange, psychrometrics, and 3D CFD streamlines.} \textbf  {a}, Headspace $\mathrm  {O}_2$ and $\mathrm  {CO}_2$ concentration dynamics with Farquhar--von Caemmerer--Berry canopy assimilation. \textbf  {b}, Trace ethylene accumulation in active sweep mode ($< 0.1\ \mathrm  {ppb}$) vs. stagnant fault ($> 130\ \mathrm  {ppb}$). \textbf  {c}, Headspace relative humidity and optical lid dew-point safety margin ($\Delta T_{\mathrm  {margin}} \ge +2.8^\circ \mathrm  {C}$). \textbf  {d}, 3D CFD streamline topologies in Push vs. Pull ventilation modes.}}{7}{figure.caption.5}\protected@file@percent }
\newlabel{fig:gas}{{5}{7}{\textbf {Chamber headspace gas exchange, psychrometrics, and 3D CFD streamlines.} \textbf {a}, Headspace $\mathrm {O}_2$ and $\mathrm {CO}_2$ concentration dynamics with Farquhar--von Caemmerer--Berry canopy assimilation. \textbf {b}, Trace ethylene accumulation in active sweep mode ($< 0.1\ \mathrm {ppb}$) vs. stagnant fault ($> 130\ \mathrm {ppb}$). \textbf {c}, Headspace relative humidity and optical lid dew-point safety margin ($\Delta T_{\mathrm {margin}} \ge +2.8^\circ \mathrm {C}$). \textbf {d}, 3D CFD streamline topologies in Push vs. Pull ventilation modes}{figure.caption.5}{}}
