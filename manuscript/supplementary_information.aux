\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Gravitational scaling and statolith-mediated root phenotypic plasticity across Earth (1.0g), Mars (0.38g), Moon (0.166g), and ISS microgravity (0.0g).} \textbf  {a}, Gravitational spectrum ladder displaying comparative seedling organ profiles. On Earth (1.0g), rapid amyloplast sedimentation establishes a strong downward gravitropic vector, leading to uniaxial downward penetration to the 35~$\mu $m Nytex screen. On Mars (0.38g) and the Moon (0.166g), sedimentation rate is attenuated by 62\% and 83.4\%, respectively, yielding delayed turning, wider radial dispersion ($35^\circ $), and extensive tangential gliding along the screen surface. In microgravity (0.0g), absence of statolith sedimentation produces stochastic root waving, autotropism, and contact-mediated thigmotropic coiling. \textbf  {b}, Linear scaling of amyloplast sedimentation velocity $v_{\mathrm  {sed}}$ proportional to effective gravity $g$, dropping from $1.85\ \mu \mathrm  {m\,min^{-1}}$ (Earth) to $0.31\ \mu \mathrm  {m\,min^{-1}}$ (Moon). \textbf  {c}, Dynamic root tip turning kinetics $\theta _{\mathrm  {root}}(t)$ over 96 hours post-imbibition. \textbf  {d}, Columella PIN3/PIN7 auxin asymmetry ratio (lower:upper statocyte membrane) saturating toward 2.8 at 1.0g and remaining unity (1.0) under microgravity. \textbf  {e}, Tangential Nytex crawl distance (reaching $2.87\ \mathrm  {mm}$ on the Moon) and waving amplitude.}}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:S1}{{1}{2}{\textbf {Gravitational scaling and statolith-mediated root phenotypic plasticity across Earth (1.0g), Mars (0.38g), Moon (0.166g), and ISS microgravity (0.0g).} \textbf {a}, Gravitational spectrum ladder displaying comparative seedling organ profiles. On Earth (1.0g), rapid amyloplast sedimentation establishes a strong downward gravitropic vector, leading to uniaxial downward penetration to the 35~$\mu $m Nytex screen. On Mars (0.38g) and the Moon (0.166g), sedimentation rate is attenuated by 62\% and 83.4\%, respectively, yielding delayed turning, wider radial dispersion ($35^\circ $), and extensive tangential gliding along the screen surface. In microgravity (0.0g), absence of statolith sedimentation produces stochastic root waving, autotropism, and contact-mediated thigmotropic coiling. \textbf {b}, Linear scaling of amyloplast sedimentation velocity $v_{\mathrm {sed}}$ proportional to effective gravity $g$, dropping from $1.85\ \mu \mathrm {m\,min^{-1}}$ (Earth) to $0.31\ \mu \mathrm {m\,min^{-1}}$ (Moon). \textbf {c}, Dynamic root tip turning kinetics $\theta _{\mathrm {root}}(t)$ over 96 hours post-imbibition. \textbf {d}, Columella PIN3/PIN7 auxin asymmetry ratio (lower:upper statocyte membrane) saturating toward 2.8 at 1.0g and remaining unity (1.0) under microgravity. \textbf {e}, Tangential Nytex crawl distance (reaching $2.87\ \mathrm {mm}$ on the Moon) and waving amplitude}{figure.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Hardware ventilation modes, chamber CFD airflow fields, and ethylene triple response phenotypes.} \textbf  {a}, 3D CFD air velocity magnitude profiles across the longitudinal coordinate $Z$ for Push mode ($Q = 25\ \mathrm  {mL\,min^{-1}}$), Pull mode ($Q = 25\ \mathrm  {mL\,min^{-1}}$), and Stagnant fault ($Q = 0$). Push mode creates a characteristic ``dip-and-converge'' jet through $Z = \pm 8.5\ \mathrm  {mm}$ baffle windows, accelerating air velocity to $80\ \mathrm  {mm\,s^{-1}}$ into Central Chamber 2. \textbf  {b}, Headspace ethylene accumulation dynamics over 120 hours. Active sweeping purges respiratory ethylene to $< 0.1\ \mathrm  {ppb}$, whereas stagnant faults result in accumulation to $136.5\ \mathrm  {ppb}$, far exceeding the $50\ \mathrm  {ppb}$ triple response threshold. \textbf  {c}, Boundary-layer conductance $g_{\mathrm  {bl}}$ plotted against hypocotyl radial swelling. In stagnant air ($g_{\mathrm  {bl}} < 3\ \mathrm  {mm\,s^{-1}}$), gas diffusion resistance traps ethylene in the boundary-layer envelope, triggering radial expansion. \textbf  {d}, Cellular organ anatomical phenotypes comparing slender, elongated seedlings in active airflow against the diagnostic triple response (swollen hypocotyl, exaggerated hook, stunted radicle) in stagnant air. \textbf  {e}, Dose-response curves of hypocotyl length and radial diameter across exogenous ethylene concentrations ($0.01$ to $10\ \mathrm  {ppm}$).}}{3}{figure.caption.2}\protected@file@percent }
\newlabel{fig:S2}{{2}{3}{\textbf {Hardware ventilation modes, chamber CFD airflow fields, and ethylene triple response phenotypes.} \textbf {a}, 3D CFD air velocity magnitude profiles across the longitudinal coordinate $Z$ for Push mode ($Q = 25\ \mathrm {mL\,min^{-1}}$), Pull mode ($Q = 25\ \mathrm {mL\,min^{-1}}$), and Stagnant fault ($Q = 0$). Push mode creates a characteristic ``dip-and-converge'' jet through $Z = \pm 8.5\ \mathrm {mm}$ baffle windows, accelerating air velocity to $80\ \mathrm {mm\,s^{-1}}$ into Central Chamber 2. \textbf {b}, Headspace ethylene accumulation dynamics over 120 hours. Active sweeping purges respiratory ethylene to $< 0.1\ \mathrm {ppb}$, whereas stagnant faults result in accumulation to $136.5\ \mathrm {ppb}$, far exceeding the $50\ \mathrm {ppb}$ triple response threshold. \textbf {c}, Boundary-layer conductance $g_{\mathrm {bl}}$ plotted against hypocotyl radial swelling. In stagnant air ($g_{\mathrm {bl}} < 3\ \mathrm {mm\,s^{-1}}$), gas diffusion resistance traps ethylene in the boundary-layer envelope, triggering radial expansion. \textbf {d}, Cellular organ anatomical phenotypes comparing slender, elongated seedlings in active airflow against the diagnostic triple response (swollen hypocotyl, exaggerated hook, stunted radicle) in stagnant air. \textbf {e}, Dose-response curves of hypocotyl length and radial diameter across exogenous ethylene concentrations ($0.01$ to $10\ \mathrm {ppm}$)}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Substrate hydraulic potential, van Genuchten retention, and water deficit phenotypic plasticity.} \textbf  {a}, Phenolic/polyurethane foam capillary retention curve modeled via the van Genuchten equation ($S_e = [1 + (\alpha |\psi |)^n]^{-m}$ with $\alpha = 0.08\ \mathrm  {kPa^{-1}}$, $n = 1.6$). Nominal 100\% activation corresponds to $\psi = -0.005\ \mathrm  {MPa}$, whereas a 40\% moisture deficit drops matric potential to $\psi = -0.26\ \mathrm  {MPa}$. \textbf  {b}, Volumetric water content $\theta _w(z)$ along the foam slab under nominal ($\theta _w \approx 0.88$) versus deficit ($\theta _w \approx 0.52$) conditions. \textbf  {c}, Seed imbibition water mass uptake curves $M(t)/M_0$ across water potentials, showing delayed hydration plateaus under water stress. \textbf  {d}, Population germination delay as a function of the hydrotime base water-potential offset $\Delta \psi _b$, yielding a $+15.7\ \mathrm  {h}$ median rupture delay under deficit. \textbf  {e}, 35~$\mu $m Nytex screen bubble-point capillary safety threshold: Young--Laplace capillary entry pressure ($\Delta P_{\mathrm  {bubble}} = 8.04\ \mathrm  {kPa}$) provides a four-fold safety margin over the end-of-mission RNAlater perfusion pressure drop ($\Delta P = 1.75\ \mathrm  {kPa}$), ensuring zero foam intrusion.}}{4}{figure.caption.3}\protected@file@percent }
\newlabel{fig:S3}{{3}{4}{\textbf {Substrate hydraulic potential, van Genuchten retention, and water deficit phenotypic plasticity.} \textbf {a}, Phenolic/polyurethane foam capillary retention curve modeled via the van Genuchten equation ($S_e = [1 + (\alpha |\psi |)^n]^{-m}$ with $\alpha = 0.08\ \mathrm {kPa^{-1}}$, $n = 1.6$). Nominal 100\% activation corresponds to $\psi = -0.005\ \mathrm {MPa}$, whereas a 40\% moisture deficit drops matric potential to $\psi = -0.26\ \mathrm {MPa}$. \textbf {b}, Volumetric water content $\theta _w(z)$ along the foam slab under nominal ($\theta _w \approx 0.88$) versus deficit ($\theta _w \approx 0.52$) conditions. \textbf {c}, Seed imbibition water mass uptake curves $M(t)/M_0$ across water potentials, showing delayed hydration plateaus under water stress. \textbf {d}, Population germination delay as a function of the hydrotime base water-potential offset $\Delta \psi _b$, yielding a $+15.7\ \mathrm {h}$ median rupture delay under deficit. \textbf {e}, 35~$\mu $m Nytex screen bubble-point capillary safety threshold: Young--Laplace capillary entry pressure ($\Delta P_{\mathrm {bubble}} = 8.04\ \mathrm {kPa}$) provides a four-fold safety margin over the end-of-mission RNAlater perfusion pressure drop ($\Delta P = 1.75\ \mathrm {kPa}$), ensuring zero foam intrusion}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Sowing density sweeps and shade-avoidance syndrome (SAS) phenotypic plasticity ($0.25\times $ to $2.0\times $ flight density).} \textbf  {a}, Top-down sowing architecture maps across 41 seeds ($0.25\times $), 82 seeds ($0.5\times $), 164 seeds ($1.0\times $ nominal flight plan), 246 seeds ($1.5\times $), and 328 seeds ($2.0\times $ saturation). \textbf  {b}, Beer--Lambert foliar canopy light extinction: canopy light transmittance $f_{\mathrm  {light}} = \exp (-k \cdot LAI)$ decreasing from $0.943$ (sparse) to $0.815$ (crowded). \textbf  {c}, Shade-avoidance hypocotyl elongation response curve: low red:far-red ratio ($R:\mathrm  {FR} < 0.35$) inactivates phytochrome B, stimulating auxin biosynthesis and driving a $+38\%$ hypocotyl elongation in Chamber 2 \textit  {Arabidopsis}. \textbf  {d}, Lateral 3D phototropic shoot lean angle $\theta _{\mathrm  {lean}}$ away from neighboring crowns, increasing monotonically from $0.22^\circ $ in sparse stands to $1.95^\circ $ at $2.0\times $ density. \textbf  {e}, Nearest-neighbor crown distance ($nnd$) distributions across species compartments.}}{5}{figure.caption.4}\protected@file@percent }
\newlabel{fig:S4}{{4}{5}{\textbf {Sowing density sweeps and shade-avoidance syndrome (SAS) phenotypic plasticity ($0.25\times $ to $2.0\times $ flight density).} \textbf {a}, Top-down sowing architecture maps across 41 seeds ($0.25\times $), 82 seeds ($0.5\times $), 164 seeds ($1.0\times $ nominal flight plan), 246 seeds ($1.5\times $), and 328 seeds ($2.0\times $ saturation). \textbf {b}, Beer--Lambert foliar canopy light extinction: canopy light transmittance $f_{\mathrm {light}} = \exp (-k \cdot LAI)$ decreasing from $0.943$ (sparse) to $0.815$ (crowded). \textbf {c}, Shade-avoidance hypocotyl elongation response curve: low red:far-red ratio ($R:\mathrm {FR} < 0.35$) inactivates phytochrome B, stimulating auxin biosynthesis and driving a $+38\%$ hypocotyl elongation in Chamber 2 \textit {Arabidopsis}. \textbf {d}, Lateral 3D phototropic shoot lean angle $\theta _{\mathrm {lean}}$ away from neighboring crowns, increasing monotonically from $0.22^\circ $ in sparse stands to $1.95^\circ $ at $2.0\times $ density. \textbf {e}, Nearest-neighbor crown distance ($nnd$) distributions across species compartments}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Deep space ionizing radiation and multi-factor spaceflight stress interaction matrix.} \textbf  {a}, Benchmark daily absorbed radiation doses across terrestrial background ($0.003\ \mathrm  {mGy\,d^{-1}}$), ISS LEO cabin ($0.35\ \mathrm  {mGy\,d^{-1}}$), lunar surface ambient GCR ($0.80\ \mathrm  {mGy\,d^{-1}}$), deep space transit ($1.45\ \mathrm  {mGy\,d^{-1}}$), and peak Solar Particle Events ($> 200\ \mathrm  {mGy\,d^{-1}}$). \textbf  {b}, High-LET $^{56}\mathrm  {Fe}$ heavy ion track structure (1~$\mathrm  {GeV/n}$) passing through the seed meristem core, inducing localized clusters of DNA double-strand breaks (DSBs) and triggering the G2/M cell-cycle checkpoint. \textbf  {c}, Root apical meristem mitotic index suppression curve as a function of absorbed dose, showing 76\% mitotic arrest under SPE doses. \textbf  {d}, Multi-stress biometric radar comparing germination rate, hypocotyl length, root Nytex crawl, stem thickness, and lean angle across nominal lunar flight, stagnant pump-off faults, and moisture deficit. \textbf  {e}, Combinatorial spaceflight morphospace mapping 120-hour hypocotyl length against tangential root crawl across all mission vectors.}}{6}{figure.caption.5}\protected@file@percent }
\newlabel{fig:S5}{{5}{6}{\textbf {Deep space ionizing radiation and multi-factor spaceflight stress interaction matrix.} \textbf {a}, Benchmark daily absorbed radiation doses across terrestrial background ($0.003\ \mathrm {mGy\,d^{-1}}$), ISS LEO cabin ($0.35\ \mathrm {mGy\,d^{-1}}$), lunar surface ambient GCR ($0.80\ \mathrm {mGy\,d^{-1}}$), deep space transit ($1.45\ \mathrm {mGy\,d^{-1}}$), and peak Solar Particle Events ($> 200\ \mathrm {mGy\,d^{-1}}$). \textbf {b}, High-LET $^{56}\mathrm {Fe}$ heavy ion track structure (1~$\mathrm {GeV/n}$) passing through the seed meristem core, inducing localized clusters of DNA double-strand breaks (DSBs) and triggering the G2/M cell-cycle checkpoint. \textbf {c}, Root apical meristem mitotic index suppression curve as a function of absorbed dose, showing 76\% mitotic arrest under SPE doses. \textbf {d}, Multi-stress biometric radar comparing germination rate, hypocotyl length, root Nytex crawl, stem thickness, and lean angle across nominal lunar flight, stagnant pump-off faults, and moisture deficit. \textbf {e}, Combinatorial spaceflight morphospace mapping 120-hour hypocotyl length against tangential root crawl across all mission vectors}{figure.caption.5}{}}
